# tools/notionsync 本地测试产物 —— 明确忽略，不入库
tools/notionsync/temp/

# Python 字节码缓存（compileall / import 自动生成，不应入库）
__pycache__/

# 一次性脚本与临时产物（用完即删，不留历史）
temp/

# lexicon 的外部数据源下载缓存（ECDICT 63 MB + Tatoeba 24 MB）
tools/lexicon/.cache/

# koolearn 抓取缓存与一次性备份
vocab/**/.cache/
vocab/**/.cache_fenlei/
vocab/koolearn-ielts/_backup_*/

# 认词判定的运行时状态与结果（个人数据，不入公开仓库）
vocab/koolearn-ielts/drill_state.json
vocab/koolearn-ielts/drill_unlearned_*.txt

# koolearn 全量抓取产物（另一套分析：数据约 61 MB + 缓存 71 MB）
vocab/koolearn-full/
